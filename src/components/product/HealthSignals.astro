---
// §5.2 — the five health signals, shown as separate bars. Deliberately NOT a
// single rolled-up rating (§4.4 no-ratings rule).
import type { HealthBreakdown } from '../../lib/api/types';
interface Props { health: HealthBreakdown; }
const { health } = Astro.props;
const rows: Array<[string, number]> = [
  ['Release', health.release],
  ['Maintainers', health.maintainers],
  ['Responsiveness', health.responsiveness],
  ['Adoption', health.adoption],
  ['Funding', health.funding],
];
---
<dl class="signals">
  {rows.map(([label, v]) => (
    <div class="signal">
      <dt>{label}</dt>
      <dd><span class="bar"><span class="fill" style={`width:${v}%`}></span></span><em>{v}</em></dd>
    </div>
  ))}
</dl>
<style>
  .signals { display: grid; gap: 0.5rem; margin: 0; }
  .signal { display: grid; grid-template-columns: 8rem 1fr; align-items: center; gap: 0.75rem; }
  .signal dt { font-size: var(--fs-sm, 0.85rem); color: var(--ash, #9aa0a6); }
  .signal dd { margin: 0; display: flex; align-items: center; gap: 0.5rem; }
  .bar { flex: 1; height: 6px; background: var(--ink-800, #1a1d21); border-radius: 3px; overflow: hidden; }
  .fill { display: block; height: 100%; background: var(--ember-500); }
  .signal em { font-family: var(--font-mono); font-style: normal; font-size: var(--fs-sm, 0.8rem); color: var(--text); min-width: 2ch; text-align: right; }
</style>
