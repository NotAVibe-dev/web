---
import type { Project } from '../../lib/api/types';
interface Props { project: Project; }
const { project } = Astro.props;
---
<a class="card" href={`/project/${project.slug}`}>
  <header>
    <span class="eco">{project.ecosystem}</span>
    <h3>{project.name}</h3>
    {project.verified && <span class="verified" title="Verified">✓</span>}
    {!project.claimed && <span class="unclaimed">unclaimed</span>}
  </header>
  <p>{project.summary}</p>
  <ul class="tags">{project.tags.map((t) => <li>{t}</li>)}</ul>
</a>
<style>
  .card {
    display: block; text-decoration: none; color: inherit;
    border: 1px solid var(--hairline); border-radius: 10px;
    padding: 1.1rem 1.25rem; background: var(--ink-850, #14161a);
    transition: border-color 0.15s ease;
  }
  .card:hover { border-color: var(--border-strong, var(--ember-700)); }
  .card header { display: flex; align-items: baseline; gap: 0.5rem; }
  .eco {
    font-family: var(--font-mono); font-size: var(--fs-kicker, 0.7rem);
    text-transform: uppercase; letter-spacing: 0.06em; color: var(--ash, #9aa0a6);
  }
  .card h3 { font-family: var(--font-mono); font-size: var(--fs-lg, 1.1rem); color: var(--text); }
  .verified { color: var(--ember-500); }
  .unclaimed {
    margin-left: auto; font-size: var(--fs-kicker, 0.7rem); color: var(--ash, #9aa0a6);
    border: 1px dashed var(--hairline); border-radius: 999px; padding: 0.05rem 0.5rem;
  }
  .card p { color: var(--ash, #9aa0a6); font-size: var(--fs-sm, 0.9rem); margin: 0.5rem 0 0.75rem; }
  .tags { display: flex; gap: 0.4rem; flex-wrap: wrap; list-style: none; padding: 0; margin: 0; }
  .tags li {
    font-family: var(--font-mono); font-size: var(--fs-kicker, 0.7rem);
    color: var(--cold-400, #8ab); background: var(--ink-800, #1a1d21);
    border-radius: 4px; padding: 0.1rem 0.4rem;
  }
</style>
