---
// Admin overview / portal (§11). Authenticated shell; mock queues until backend.
import AppLayout from '../../../layouts/AppLayout.astro';
import { getAdminOverview } from '../../../lib/api/client';
const { queues } = await getAdminOverview();
const groups = ['Adjudication', 'Catalog', 'Integrity', 'Platform'] as const;
---
<AppLayout title="Admin" role="admin">
  <p class="kicker">Platform operator</p>
  <h1>Overview</h1>
  {groups.map((g) => (
    <section id={g.toLowerCase()}>
      <h2>{g}</h2>
      <ul>
        {queues.filter((q) => q.group === g).map((q) => (
          <li><span>{q.name}</span><em data-pending={q.pending > 0}>{q.pending}</em></li>
        ))}
      </ul>
    </section>
  ))}
</AppLayout>
<style>
  .kicker { font-family: var(--font-mono); text-transform: uppercase; letter-spacing: 0.08em; color: var(--ember-500); font-size: var(--fs-kicker, 0.75rem); }
  h1 { font-family: var(--font-mono); font-size: var(--fs-h1); color: var(--text); margin-bottom: 1.5rem; }
  h2 { font-family: var(--font-mono); font-size: var(--fs-h3); color: var(--text); margin: 1.5rem 0 0.75rem; }
  ul { list-style: none; padding: 0; margin: 0; display: grid; gap: 0.4rem; }
  li { display: flex; align-items: center; border: 1px solid var(--hairline); border-radius: 8px; padding: 0.6rem 1rem; background: var(--ink-850, #14161a); }
  li span { font-size: var(--fs-sm, 0.9rem); color: var(--text); }
  li em { margin-left: auto; font-style: normal; font-family: var(--font-mono); color: var(--ash, #9aa0a6); }
  li em[data-pending="true"] { color: var(--ember-500); }
</style>
