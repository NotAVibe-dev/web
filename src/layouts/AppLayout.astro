---
// Authenticated product shell (dashboards / portals). Sibling to Base.astro
// (marketing). Role-gated: maintainer / backer / admin (SPEC §7.1, §9, §11).
// Auth itself is GitHub-App sign-in, wired when the backend repo (app/crm) is
// chosen — for now `role` is passed in so the shell renders.
import '@fontsource/inter/400.css';
import '@fontsource/inter/500.css';
import '@fontsource/inter/600.css';
import '@fontsource/jetbrains-mono/400.css';
import '@fontsource/jetbrains-mono/500.css';
import '../styles/tokens.css';
import '../styles/global.css';
import type { Role } from '../lib/api/types';

interface Props { title?: string; role: Role; }
const { title = 'notavibe', role } = Astro.props;

const nav: Record<Role, Array<{ href: string; label: string }>> = {
  maintainer: [
    { href: '/app/maintainer', label: 'Dashboard' },
    { href: '/app/maintainer#presence', label: 'Discovery presence' },
    { href: '/app/maintainer#contests', label: 'Claim contests' },
  ],
  backer: [
    { href: '/app/backer', label: 'Dashboard' },
    { href: '/app/backer#lists', label: 'My lists' },
    { href: '/app/backer#scan', label: 'Discover your stack' },
  ],
  admin: [
    { href: '/app/admin', label: 'Overview' },
    { href: '/app/admin#adjudication', label: 'Adjudication' },
    { href: '/app/admin#integrity', label: 'Integrity' },
  ],
};
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title} · notavibe</title>
    <meta name="robots" content="noindex" /><!-- authenticated app: not for crawlers -->
    <meta name="color-scheme" content="dark" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  </head>
  <body class="app-shell">
    <aside class="app-rail">
      <a href="/" class="app-brand">notavibe</a>
      <p class="app-role">{role}</p>
      <nav>
        {nav[role].map((item) => <a href={item.href}>{item.label}</a>)}
      </nav>
    </aside>
    <main class="app-main">
      <slot />
    </main>

    <style>
      .app-shell { display: grid; grid-template-columns: 15rem 1fr; min-height: 100vh; }
      .app-rail {
        border-right: 1px solid var(--hairline);
        padding: var(--gutter, 1.5rem);
        display: flex; flex-direction: column; gap: 1rem;
        background: var(--ink-850, #14161a);
      }
      .app-brand { font-family: var(--font-mono); font-weight: 700; color: var(--text); }
      .app-role {
        font-family: var(--font-mono); font-size: var(--fs-kicker, 0.75rem);
        text-transform: uppercase; letter-spacing: 0.08em; color: var(--ember-500);
      }
      .app-rail nav { display: flex; flex-direction: column; gap: 0.25rem; }
      .app-rail nav a {
        color: var(--ash, #9aa0a6); text-decoration: none; padding: 0.4rem 0.5rem;
        border-radius: 6px; font-size: var(--fs-sm, 0.9rem);
      }
      .app-rail nav a:hover { color: var(--text); background: var(--ink-800, #1a1d21); }
      .app-main { padding: calc(var(--gutter, 1.5rem) * 1.5); max-width: var(--maxw, 72rem); }
      @media (max-width: 720px) { .app-shell { grid-template-columns: 1fr; } .app-rail { flex-direction: row; align-items: center; flex-wrap: wrap; } }
    </style>
  </body>
</html>
